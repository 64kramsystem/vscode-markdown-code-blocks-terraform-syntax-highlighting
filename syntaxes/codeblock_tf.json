{
  "scopeName": "markdown.tf.codeblock",
  "injectionSelector": "L:text.html.markdown - markup.fenced_code.block.markdown - markup.raw.block.markdown",
  "patterns": [
    {
      "comment": "The inner while rule uses the opener to end unfinished strings at the closing fence.",
      "begin": "(^|\\G)([ ]{0,3})(?=(`{3,}|~{3,})[ \\t]*(?i:tf|terraform)([ \\t]+[^`]*)?$)",
      "name": "markup.fenced_code.block.markdown",
      "end": "(^|\\G)(\\2|[ ]{0,3})(\\3(?:(?<=`)`*|(?<=~)~*))[ \\t]*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "patterns": [
        {
          "begin": "\\G(`{3,}|~{3,})[ \\t]*(?i:(tf|terraform))([ \\t]+[^`]*)?$",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.markdown"
            },
            "2": {
              "name": "fenced_code.block.language.markdown"
            },
            "3": {
              "name": "fenced_code.block.language.attributes.markdown"
            }
          },
          "while": "(^|\\G)(?![ ]{0,3}\\1(?:(?<=`)`*|(?<=~)~*)[ \\t]*$)",
          "contentName": "meta.embedded.block.markdown-code-blocks.terraform",
          "patterns": [
            {
              "include": "source.markdown-code-blocks.terraform"
            }
          ]
        }
      ]
    }
  ]
}
